# SPDX-License-Identifier: Apache-2.0
# Names of the settings of ParlPDFeCH, without values (README.md, chapter "Settings").
# The scripts do not read a file .env. Copy this file to .env, put the values there and load them
# into the environment, for example: set -a; . ./.env; set +a
# Never commit a file with values.

# Names of the Hack Apertus template. The current pipeline does not use them.
LLM_NAME=
LLM_BASE_URL=
LLM_API_KEY=

# Download of Apertus-v1.5-8B from Hugging Face (own account; license and use policy accepted).
# No script of this repository reads it.
HF_TOKEN=

# Data root of the scripts (absolute path). Without a value: track_2a/data
PARLPDFECH_DATA=

# Stratified sample: the list and the folder of its PDF files.
# Without a value: <data>/analyse/stichprobe/auswahl.csv and <data>/pdf/stichprobe
PARLPDFECH_SAMPLE_LIST=
PARLPDFECH_SAMPLE_PDF=

# Optional: the pdftotext program of src/m03_docling_zerlegen.py; the device of src/m04_iso_torch.py
PDFTOTEXT=
ISO_DEVICE=

# Optional: rented GPU (src/m04_runpod.py). RUNPOD_SSH_KEY: the private key file; without a value:
# ~/.ssh/runpod_parlpdfech
RUNPOD_API_KEY=
RUNPOD_SSH_KEY=
