# Secrets and local config
.env
.env.*
!.env.example

# Model weights and checkpoints — do not commit these
*.bin
*.safetensors
*.gguf
*.ckpt
*.pt

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node
node_modules/
dist/
build/

# OS and editor
.DS_Store
.idea/
.vscode/

# PDF documents: never in the repository, except the 3 sample PDFs (see app/.gitignore)
*.pdf

# Pipeline data below the default data root (PARLPDFECH_DATA): never in the repository
data/*
!data/.gitkeep

# Downloads of make setup (eCH-0295 schema files): never in the repository
.cache/

# Results of make convert (own PDFs, the catalog of the IDs): never in the repository
/out/
