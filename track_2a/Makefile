.PHONY: run

# The Hack Apertus template asks for a command that starts the project in a Docker container
# and works from a clean checkout. ParlPDFeCH has no such command yet: the converter is not
# complete and there is no container file (README.md, chapter "Run it").
run:
	@echo "make run is not ready: the ParlPDFeCH converter is not complete and has no container yet (see README.md, chapter \"Run it\")."; exit 1
