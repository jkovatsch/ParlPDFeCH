# Optional settings of 'make run'. The package needs no secret value.
# Use: set a variable in the shell, for example  PARLPDFECH_PORT=9090 make run
#
# The template of the hackathon names three variables with the prefix LLM_.
# This package does not read them: it calls no model and no other host at run time.

# Port on this computer.
PARLPDFECH_PORT=8080
